{
  "_comment": "Одобренные эффекты uniquize. vf = -vf chain, complex = filter_complex ( strobo/flash ).",
  "_updated": "2026-08-26",

  "vf": {
    "faded_film": {
      "desc": "unsharp + low contrast + warm grade + vignette",
      "filter": "unsharp=5:5:1.0:5:5:0.5,eq=contrast=0.88:brightness=0.03:gamma=1.05,colorbalance=rs=0.04:gs=0.02:bs=-0.03,vignette=PI/3.5"
    },
    "hue_rotate": {
      "desc": "hue=150° + slight desat",
      "filter": "hue=h=150:s=0.7"
    },
    "color_pulse": {
      "desc": "hue=90° + sat=3.0 + contrast=1.4",
      "filter": "hue=h=90:s=3.0,eq=contrast=1.4:brightness=-0.03"
    },
    "bleach_negate": {
      "desc": "negate + low contrast + desat",
      "filter": "negate,eq=contrast=0.85:saturation=0.4:brightness=0.06:gamma=1.1"
    },
    "film_burn": {
      "desc": "высокая экспозиция + warm grade + grain",
      "filter": "eq=brightness=0.08:contrast=1.2:saturation=1.3:gamma=0.92,colorbalance=rs=0.08:rm=0.05:gh=0.03,noise=alls=16:allf=t+u"
    },
    "mirror_split": {
      "desc": "зеркальное отражение",
      "filter": "hflip"
    },
    "screen_interference": {
      "desc": "CRT scanlines + noise + flicker яркости",
      "filter": "drawgrid=w=0:h=2:t=1:color=white@0.06,noise=alls=22:allf=t+u,eq=brightness=0.03*sin(t*18):contrast=1.15:saturation=0.6"
    },
    "parallax": {
      "desc": "scale-up 1.04-1.10x + animated crop drift",
      "_generator": "parallax_filter"
    },
    "slide_crop": {
      "desc": "oversized кадр едет горизонтально",
      "_generator": "slide_crop_filter"
    },
    "corner_sweep": {
      "desc": "crop по дуге из угла в угол",
      "_generator": "corner_sweep_filter"
    },
    "zoom_drift": {
      "desc": "oversized + синусоидальный дрейф crop'а",
      "_generator": "zoom_drift_filter"
    },
    "diagonal_crop": {
      "desc": "oversized кадр едет по диагонали",
      "_generator": "diagonal_crop_filter"
    }
  },

  "complex": {
    "strobo": {
      "desc": "чередование яркий↔инверсия ( strobo_graph )",
      "_generator": "strobo_graph",
      "flash_pct_range": [0.35, 0.50]
    },
    "flash": {
      "desc": "вспышка для дропов/климаксов",
