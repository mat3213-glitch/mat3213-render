    },
    "grid_2x2": {
      "desc": "4 версии кадра в сетке, внутренний дрейф",
      "_generator": "grid_2x2_filter"
    },
    "split_converge": {
      "desc": "2 горизонтальные полосы сходятся к центру",
      "_generator": "split_converge_filter"
    },
    "negative_echo": {
      "desc": "negate + screen blend с оригиналом",
      "complex": "[0:v]split[a][b];[a]negate,eq=brightness=-0.04[na];[b][na]blend=all_mode=screen:all_opacity=0.24"
    },
    "self_blend_reverse": {
      "desc": "клип поверх自己 инвертированной reverse-версии",
      "complex": "[0:v]split[a][b];[b]reverse[neg];[a][neg]blend=all_mode=average:all_opacity=0.5"
    },
    "motion_pan": {
      "desc": "2 копии едут в противоположные стороны + screen blend",
      "complex": "[0:v]scale=1408:792,split[a][b];[a]crop=1280:720:x='64+48*sin(t*0.3)':y='36+28*cos(t*0.25)',format=gbrp[ca];[b]crop=1280:720:x='64+48*cos(t*0.3)':y='36+28*sin(t*0.25)',format=gbrp[cb];[ca][cb]blend=all_mode=screen:all_opacity=0.55"
    }
  },

